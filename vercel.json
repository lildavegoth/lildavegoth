{
    "headers": [
        {
            "source": "/images/*.(mp4|webm|ogg)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/images/:path*",
            "destination": "https://raw.githubusercontent.com/lildavegoth/lildavegoth/homepage/pages/articles/images/:path*"
        },
        {
            "source": "/files/fetch/kiraku-store/products.json",
            "destination": "/api/products"
        },
        {
            "source": "/files/fetch/kiraku-store/owned.json",
            "destination": "/api/owned"
        }
    ]
}