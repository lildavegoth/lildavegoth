const style = document.createElement('style');
style.textContent = `
    .notification-container-notif {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: 300px;
        z-index: 999999999999999;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 120px;
        pointer-events: none;
    }

    .notification-container-notif::after {
        content: '';
        position: absolute;
        bottom: -15px;
        left: 50%;
        transform: translateX(-50%);
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.3);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .notification-container-notif.has-queue-notif::after {
        opacity: 1;
    }

    .notification-wrapper-notif {
        position: relative;
        width: 100%;
        margin-bottom: -40px;
        display: flex;
        justify-content: center;
    }

    .notification-notif {
        background-color: #000000;
        border-radius: 25px;
        padding: 18px 26px;
        display: flex;
        align-items: center;
        gap: 24px;
        width: 100%;
        box-sizing: border-box;
        animation: slideInTop-notif 0.3s ease-out;
        pointer-events: auto;
        border: 2px solid #333;
    }

    .notification-wrapper-notif:not(:first-child) .notification-notif {
        transform: scale(0.92) translateY(-10px);
        opacity: 0.95;
    }

    .notification-wrapper-notif:nth-child(2) .notification-notif {
        margin-top: -30px;
    }

    .content-notif {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
    }

    .badge-notif {
        background-color: #C1FC32;
        color: #000000;
        padding: 3px 12px;
        border-radius: 9999px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.5px;
        width: fit-content;
        margin-right: auto;
    }

    .text-notif {
        color: #ffffff;
        font-size: 17px;
        font-weight: 600;
        margin: 0;
        line-height: 1.3;
        margin-right: auto;
        word-break: break-word;
        text-transform: uppercase;
        margin-top: 5px;
    }

    .close-btn-notif {
        background-color: #C1FC32;
        width: 42px;
        height: 68px;
        margin-right: -10px;
        margin-left: auto;
        border-radius: 15px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1px;
        cursor: pointer;
        flex-shrink: 0;
    }

    .x-notif {
        color: #000000;
        font-size: 25px;
        font-weight: 999;
        line-height: 1;
        margin-bottom: -5px;
        margin-top: -5px;
    }

    .timer-progress-container-notif {
        width: 100%;
        height: 6px;
        background-color: #333;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 8px;
    }

    .timer-progress-bar-notif {
        width: 0%;
        height: 100%;
        background-color: #C1FC32;
        border-radius: 0 3px 3px 0;
        transition: width 0.2s linear;
    }

    .timer-time-notif {
        color: #C1FC32;
        font-size: 14px;
        font-weight: 600;
        margin-top: 5px;
        text-align: left;
        font-family: monospace;
    }

    @keyframes slideInTop-notif {
        from {
            opacity: 0;
            transform: translateY(-100px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slideOutTop-notif {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(-100px);
        }
    }

    .notification-wrapper-notif.removing-notif .notification-notif {
        animation: slideOutTop-notif 0.3s ease-in forwards;
    }

    @media (max-width: 768px) {
        .notification-container-notif {
            top: 10px;
            left: 10px;
            right: 10px;
            width: auto;
            transform: none;
        }
        
        .notification-wrapper-notif {
            margin-bottom: -30px;
        }
        
        .notification-wrapper-notif:not(:first-child) .notification-notif {
            transform: scale(0.94) translateY(-8px);
            margin-top: -20px;
        }
        
        .notification-notif {
            padding: 14px 20px;
            gap: 16px;
        }
        
        .close-btn-notif {
            width: 36px;
            height: 58px;
        }
        
        .badge-notif {
            font-size: 11px;
            padding: 2px 10px;
        }
        
        .text-notif {
            font-size: 15px;
        }
        
        .timer-time-notif {
            font-size: 12px;
        }
    }
`;
document.head.appendChild(style);

(() => {
    let container = null;
    let notificationCount = 0;
    let notificationQueue = [];
    let maxNotifications = 2;

    function getContainer() {
        if (!container) {
            container = document.createElement("div");
            container.className = "notification-container-notif";
            document.body.appendChild(container);
        }
        return container;
    }

    function updateNotificationStacking() {
        const wrappers = container.querySelectorAll('.notification-wrapper-notif');
        const totalWrappers = wrappers.length;
        wrappers.forEach((wrapper, index) => {
            wrapper.style.zIndex = 100 + (totalWrappers - index - 1);
        });
    }

    function closeNotification(wrapper) {
        wrapper.classList.add("removing-notif");
        setTimeout(() => {
            if (wrapper.parentNode) {
                wrapper.remove();
                notificationCount--;
                updateNotificationStacking();
                if (notificationQueue.length > 0) {
                    const nextNotification = notificationQueue.shift();
                    createNotification(nextNotification);
                }
            }
        }, 300);
    }

    function createNotification(data) {
        if (notificationCount >= maxNotifications) {
            notificationQueue.push(data);
            return;
        }

        notificationCount++;

        const wrapper = document.createElement("div");
        wrapper.className = "notification-wrapper-notif";

        const notificationEl = document.createElement("div");
        notificationEl.className = "notification-notif";

        const contentDiv = document.createElement("div");
        contentDiv.className = "content-notif";

        if (data.customHtml) {
            contentDiv.innerHTML = data.customHtml;
        } else {
            const badgeSpan = document.createElement("span");
            badgeSpan.className = "badge-notif";
            badgeSpan.textContent = (data.type || "NOTIFICATION").toUpperCase();

            const textP = document.createElement("p");
            textP.className = "text-notif";
            textP.textContent = data.title + (data.extraText ? ": " + data.extraText : "");

            contentDiv.appendChild(badgeSpan);
            contentDiv.appendChild(textP);
        }

        const closeBtnDiv = document.createElement("div");
        closeBtnDiv.className = "close-btn-notif";

        const x1 = document.createElement("span");
        x1.className = "x-notif";
        x1.innerHTML = "×";

        const x2 = document.createElement("span");
        x2.className = "x-notif";
        x2.innerHTML = "×";

        closeBtnDiv.appendChild(x1);
        closeBtnDiv.appendChild(x2);
        closeBtnDiv.addEventListener("click", () => closeNotification(wrapper));

        notificationEl.appendChild(contentDiv);
        notificationEl.appendChild(closeBtnDiv);
        wrapper.appendChild(notificationEl);

        const cont = getContainer();
        if (cont.firstChild) {
            cont.insertBefore(wrapper, cont.firstChild);
        } else {
            cont.appendChild(wrapper);
        }

        updateNotificationStacking();

        if (data.duration !== undefined && data.duration !== Infinity) {
            setTimeout(() => {
                closeNotification(wrapper);
            }, data.duration);
        }

        if (data.onClose) {
            wrapper.addEventListener('removing-notif', data.onClose);
        }

        return {
            wrapper: wrapper,
            close: () => closeNotification(wrapper)
        };
    }

    function formatTime(seconds) {
        const hours = Math.floor(seconds / 3600);
        const minutes = Math.floor((seconds % 3600) / 60);
        const secs = seconds % 60;
        if (hours > 0) {
            return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }
        return `${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    window.createTimerNotification = (title, totalSeconds, customFormatter) => {
        const timerId = Date.now();
        let currentSeconds = totalSeconds;

        const customHtml = `
            <div class="timer-content-notif" data-timer-id="${timerId}">
                <div class="badge-notif">Notification</div>
                <div class="text-notif">${title}</div>
                <div class="timer-time-notif" id="timer-time-${timerId}">${formatTime(totalSeconds)}</div>
                <div class="timer-progress-container-notif">
                    <div class="timer-progress-bar-notif" id="timer-progress-${timerId}" style="width: 100%;"></div>
                </div>
            </div>
        `;

        const notification = createNotification({
            customHtml: customHtml,
            duration: Infinity,
            onClose: () => {
                if (window._timerNotifications && window._timerNotifications[timerId]) {
                    delete window._timerNotifications[timerId];
                }
            }
        });

        if (!window._timerNotifications) window._timerNotifications = {};
        window._timerNotifications[timerId] = notification;

        const update = (remainingSeconds, total) => {
            if (!notification.wrapper.parentNode) return;
            const percent = (remainingSeconds / total) * 100;
            const progressBar = document.getElementById(`timer-progress-${timerId}`);
            const timeSpan = document.getElementById(`timer-time-${timerId}`);
            if (progressBar) progressBar.style.width = `${Math.max(0, percent)}%`;
            if (timeSpan) {
                if (customFormatter && typeof customFormatter === 'function') {
                    timeSpan.textContent = customFormatter(remainingSeconds, total);
                } else {
                    timeSpan.textContent = formatTime(remainingSeconds);
                }
            }
            currentSeconds = remainingSeconds;
        };

        const close = () => {
            notification.close();
        };

        update(totalSeconds, totalSeconds);

        return {
            update: update,
            close: close,
            wrapper: notification.wrapper
        };
    };

    window.showMessage = (title, message, type, appName, extraText, duration) => {
        type = type || "Notification";
        appName = appName || "";
        message = message || "";
        extraText = extraText || "";
        duration = duration || 4000;

        const finalExtra = extraText || message;

        const notificationData = {
            title: title,
            type: type,
            extraText: finalExtra,
            duration: duration
        };

        createNotification(notificationData);
    };

    const oldContainer = document.querySelector('.notification-container-notif');
    if (oldContainer) oldContainer.remove();
})();