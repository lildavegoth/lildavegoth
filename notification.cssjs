const style = document.createElement('style');
style.textContent = `
.notification-container-notif {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    z-index: 999999999999999;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 120px;
    pointer-events: none;
}

.notification-container-notif::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.3);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.notification-container-notif.has-queue-notif::after {
    opacity: 1;
}

.notification-wrapper-notif {
    position: relative;
    width: 100%;
    margin-bottom: -40px;
    display: flex;
    justify-content: center;
}

.notification-notif {
    background-color: #000000;
    border-radius: 25px;
    padding: 18px 26px;
    display: flex;
    align-items: center;
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
    animation: slideInTop-notif 0.3s ease-out;
    pointer-events: auto;
    border: 2px solid #333;
}

.notification-wrapper-notif:not(:first-child) .notification-notif {
    transform: scale(0.92) translateY(-10px);
    opacity: 0.95;
}

.notification-wrapper-notif:nth-child(2) .notification-notif {
    margin-top: -30px;
}

.content-notif {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
}

.badge-notif {
    background-color: #bef264;
    color: #000000;
    padding: 3px 12px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    width: fit-content;
    margin-right: auto;
}

.text-notif {
    color: #ffffff;
    font-size: 17px;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
    margin-right: auto;
    word-break: break-word;
    text-transform: uppercase;
    margin-top: 5px;
}

.close-btn-notif {
    background-color: #bef264;
    width: 42px;
    height: 68px;
    margin-right: -5px;
    margin-left: auto;
    border-radius: 15px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1px;
    cursor: pointer;
    flex-shrink: 0;
}

.x-notif {
    color: #000000;
    font-size: 25px;
    font-weight: 999;
    line-height: 1;
    margin-bottom: -5px;
    margin-top: -5px;
}

@keyframes slideInTop-notif {
    from {
        opacity: 0;
        transform: translateY(-100px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideOutTop-notif {
    from {
        opacity: 1;
        transform: translateY(0);
    }
    to {
        opacity: 0;
        transform: translateY(-100px);
    }
}

.notification-wrapper-notif.removing-notif .notification-notif {
    animation: slideOutTop-notif 0.3s ease-in forwards;
}

@media (max-width: 768px) {
    .notification-container-notif {
        top: 10px;
        left: 10px;
        right: 10px;
        width: auto;
        transform: none;
    }
    
    .notification-wrapper-notif {
        margin-bottom: -30px;
    }
    
    .notification-wrapper-notif:not(:first-child) .notification-notif {
        transform: scale(0.94) translateY(-8px);
        margin-top: -20px;
    }
    
    .notification-notif {
        padding: 14px 20px;
        gap: 16px;
    }
    
    .close-btn-notif {
        width: 36px;
        height: 58px;
    }
    
    .badge-notif {
        font-size: 11px;
        padding: 2px 10px;
    }
    
    .text-notif {
        font-size: 15px;
    }
}
`;
document.head.appendChild(style);

(() => {
    let container = null;
    let notificationCount = 0;
    let notificationQueue = [];
    let maxNotifications = 2;
    
    function getContainer() {
        if (!container) {
            container = document.createElement("div");
            container.className = "notification-container-notif";
            document.body.appendChild(container);
        }
        return container;
    }
    
    function updateNotificationStacking() {
        const wrappers = container.querySelectorAll('.notification-wrapper-notif');
        const totalWrappers = wrappers.length;
        
        wrappers.forEach((wrapper, index) => {
            wrapper.style.zIndex = 100 + (totalWrappers - index - 1);
        });
    }
    
    function closeNotification(wrapper) {
        wrapper.classList.add("removing-notif");
        setTimeout(() => {
            if (wrapper.parentNode) {
                wrapper.remove();
                notificationCount--;
                
                updateNotificationStacking();
                
                if (notificationQueue.length > 0) {
                    const nextNotification = notificationQueue.shift();
                    createNotification(nextNotification);
                }
            }
        }, 300);
    }
    
    function createNotification(data) {
        if (notificationCount >= maxNotifications) {
            notificationQueue.push(data);
            return;
        }
        
        notificationCount++;
        
        const wrapper = document.createElement("div");
        wrapper.className = "notification-wrapper-notif";
        
        const notificationEl = document.createElement("div");
        notificationEl.className = `notification-notif`;
        
        const contentDiv = document.createElement("div");
        contentDiv.className = "content-notif";
        
        const badgeSpan = document.createElement("span");
        badgeSpan.className = "badge-notif";
        badgeSpan.textContent = data.type.toUpperCase();
        
        const textP = document.createElement("p");
        textP.className = "text-notif";
        textP.textContent = data.title + (data.extraText ? ": " + data.extraText : "");
        
        contentDiv.appendChild(badgeSpan);
        contentDiv.appendChild(textP);
        
        const closeBtnDiv = document.createElement("div");
        closeBtnDiv.className = "close-btn-notif";
        
        const x1 = document.createElement("span");
        x1.className = "x-notif";
        x1.innerHTML = "×";
        
        const x2 = document.createElement("span");
        x2.className = "x-notif";
        x2.innerHTML = "×";
        
        closeBtnDiv.appendChild(x1);
        closeBtnDiv.appendChild(x2);
        
        closeBtnDiv.addEventListener("click", () => closeNotification(wrapper));
        
        notificationEl.appendChild(contentDiv);
        notificationEl.appendChild(closeBtnDiv);
        
        wrapper.appendChild(notificationEl);
        
        const cont = getContainer();
        
        if (cont.firstChild) {
            cont.insertBefore(wrapper, cont.firstChild);
        } else {
            cont.appendChild(wrapper);
        }
        
        updateNotificationStacking();
        
        if (data.duration !== Infinity) {
            setTimeout(() => {
                closeNotification(wrapper);
            }, data.duration);
        }
    }
    
    window.showMessage = (title, message, type, appName, extraText, duration) => {
        type = type || "Notification";
        appName = appName || "";
        message = message || "";
        extraText = extraText || "";
        duration = duration || 4000;
        
        const notificationData = {
            title,
            type,
            extraText,
            duration
        };
        
        createNotification(notificationData);
    };
})();