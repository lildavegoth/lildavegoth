// CSS
const style = document.createElement('style');
style.textContent = `
.notification-container {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 320px;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 120px;
    pointer-events: none;
}

.notification-container::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.3);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.notification-container.has-queue::after {
    opacity: 1;
}

.notification-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: -40px;
}

.notification {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    animation: slideInTop 0.3s ease-out;
    min-height: 80px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    width: 100%;
    pointer-events: auto;
}

.notification-wrapper:not(:first-child) .notification {
    transform: scale(0.92) translateY(-10px);
    opacity: 0.95;
    position: relative;
    left: 50%;
    transform: translateX(-50%) scale(0.92) translateY(-10px);
}

.notification-wrapper:nth-child(2) .notification {
    margin-top: -30px;
}

@media (max-width: 768px) {
    .notification-wrapper:not(:first-child) .notification {
        left: 0;
        transform: scale(0.94) translateY(-8px);
        margin-top: -20px;
    }
}

.notification-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
    width: 100%;
    min-height: 32px;
}

.notification-header-content {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-grow: 1;
}

.notification-close-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-size: 25px;
    cursor: pointer;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    transition: all 0.3s ease;
    flex-shrink: 0;
}

.notification-close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
    transform: scale(1.1);
}

.notification-close-btn:active {
    transform: scale(0.95);
}

.notification-time {
    font-size: 0.6rem;
    font-weight: 1000;
    color: rgba(255, 255, 255, 0.7);
    white-space: nowrap;
    margin-left: 8px;
}

.notification-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    color: #000000;
}

.notification.success .notification-pill {
    background-color: #c1fc32;
    box-shadow: 0 2px 8px rgba(193, 252, 50, 0.3);
}

.notification.error .notification-pill {
    background-color: #ff3b30;
    color: white;
    box-shadow: 0 2px 8px rgba(255, 59, 48, 0.3);
}

.notification.warning .notification-pill {
    background-color: #ff3b30;
    color: white;
    box-shadow: 0 2px 8px rgba(255, 59, 48, 0.3);
}

.notification-pill {
    background-color: #c1fc32;
    color: black;
    backdrop-filter: blur(10px);
    font-size: 0.5rem;
    font-weight: 1000;
}

.notification-pill:hover {
    transform: scale(1.05);
}

@keyframes slideInTop {
    from {
        opacity: 0;
        transform: translate(-50%, -100px);
    }
    to {
        opacity: 1;
        transform: translate(-50%, 0);
    }
}

@keyframes slideOutTop {
    from {
        opacity: 1;
        transform: translate(-50%, 0);
    }
    to {
        opacity: 0;
        transform: translate(-50%, -100px);
    }
}

.notification-wrapper.removing .notification {
    animation: slideOutTop 0.3s ease-in forwards;
}

@media (max-width: 768px) {
    .notification-container {
        top: 10px;
        right: 10px;
        left: 10px;
        width: auto;
        transform: none;
        pointer-events: none;
    }
    
    .notification-wrapper {
        margin-bottom: -30px;
    }
    
    .notification-wrapper:not(:first-child) .notification {
        left: 0;
        transform: scale(0.94);
    }
    
    .notification-close-btn {
        width: 24px;
        height: 24px;
        font-size: 20px;
    }
    
    .notification-header {
        gap: 4px;
    }
    
    .notification-header-content {
        gap: 6px;
    }
    
    .notification-time {
        font-size: 0.55rem;
        margin-left: 6px;
    }
    
    @keyframes slideInTop {
        from {
            opacity: 0;
            transform: translateY(-100px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @keyframes slideOutTop {
        from {
            opacity: 1;
            transform: translateY(0);
        }
        to {
            opacity: 0;
            transform: translateY(-100px);
        }
    }
}
`;
document.head.appendChild(style);

// JavaScript

(() => {
    let container = null;
    let notificationCount = 0;
    let notificationQueue = [];
    let maxNotifications = 2;
    
    function getContainer() {
        if (!container) {
            container = document.createElement("div");
            container.className = "notification-container";
            document.body.appendChild(container);
        }
        return container;
    }
    
    function getTimeString() {
        const now = new Date();
        const hour = now.getHours();
        const minute = now.getMinutes();
        const ampm = hour >= 12 ? "PM" : "AM";
        const displayHour = hour % 12 || 12;
        return `${displayHour}:${minute.toString().padStart(2, "0")} ${ampm}`;
    }
    
    function updateNotificationStacking() {
        const wrappers = container.querySelectorAll('.notification-wrapper');
        const totalWrappers = wrappers.length;
        
        wrappers.forEach((wrapper, index) => {
            wrapper.style.zIndex = 100 + (totalWrappers - index - 1);
        });
    }
    
    function closeNotification(wrapper) {
        wrapper.classList.add("removing");
        setTimeout(() => {
            if (wrapper.parentNode) {
                wrapper.remove();
                notificationCount--;
                
                updateNotificationStacking();
                
                if (notificationQueue.length > 0) {
                    const nextNotification = notificationQueue.shift();
                    createNotification(nextNotification);
                }
            }
        }, 300);
    }
    
    function createNotification(data) {
        if (notificationCount >= maxNotifications) {
            notificationQueue.push(data);
            return;
        }
        
        notificationCount++;
        
        const wrapper = document.createElement("div");
        wrapper.className = "notification-wrapper";
        
        const notificationEl = document.createElement("div");
        notificationEl.className = `notification ${data.type}`;
        
        const pillText = data.type.toUpperCase();
        
        const headerDiv = document.createElement("div");
        headerDiv.className = "notification-header";
        
        const headerContent = document.createElement("div");
        headerContent.className = "notification-header-content";
        
        const pillSpan = document.createElement("span");
        pillSpan.className = `notification-pill ${data.type}-pill`;
        pillSpan.textContent = pillText;
        
        const timeSpan = document.createElement("span");
        timeSpan.className = "notification-time";
        timeSpan.textContent = getTimeString();
        
        const closeBtn = document.createElement("button");
        closeBtn.className = "notification-close-btn";
        closeBtn.innerHTML = "×";
        closeBtn.addEventListener("click", () => closeNotification(wrapper));
        
        headerContent.appendChild(pillSpan);
        headerContent.appendChild(timeSpan);
        
        headerDiv.appendChild(headerContent);
        headerDiv.appendChild(closeBtn);
        
        const titleDiv = document.createElement("div");
        titleDiv.className = "notification-title";
        titleDiv.textContent = data.title;
        
        notificationEl.appendChild(headerDiv);
        notificationEl.appendChild(titleDiv);
        
        if (data.extraText) {
            const extraDiv = document.createElement("div");
            extraDiv.className = "notification-extra";
            extraDiv.textContent = data.extraText;
            notificationEl.appendChild(extraDiv);
        }
        
        wrapper.appendChild(notificationEl);
        
        const cont = getContainer();
        
        if (cont.firstChild) {
            cont.insertBefore(wrapper, cont.firstChild);
        } else {
            cont.appendChild(wrapper);
        }
        
        updateNotificationStacking();
        
        if (data.duration !== Infinity) {
            setTimeout(() => {
                closeNotification(wrapper);
            }, data.duration);
        }
    }
    
    window.showMessage = (title, message, type, appName, extraText, duration) => {
        type = type || "Notification";
        appName = appName || "";
        message = message || "";
        extraText = extraText || "";
        duration = duration || 4000;
        
        const notificationData = {
            title,
            type,
            extraText,
            duration
        };
        
        createNotification(notificationData);
    };
})();