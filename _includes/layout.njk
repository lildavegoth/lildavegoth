<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title if title else "Kiraku Home" }}</title>
    <script src="/protections.js"></script>
    <script>
    (function() {
        var allowed = ['lildavegoth.github.io', 'kakoi-kiraku-home.vercel.app'];
        var host = window.location.hostname;
        var isFile = window.location.protocol === 'file:';
        if (isFile || allowed.indexOf(host) === -1 || typeof window.__PROTECTIONS_LOADED__ === 'undefined') {
            document.addEventListener('DOMContentLoaded', function() {
                document.body.innerHTML = '<div style="text-align:center;margin-top:50px;font-family:sans-serif"><h1>🔒 Content Protected</h1><p>This content cannot be viewed outside the official site.</p></div>';
            });
            throw new Error('Access denied');
        }
    })();
    </script>
</head>
<body>
    {{ content | safe }}
</body>
</html>
