import re
from base_plugin import BasePlugin, HookResult, HookStrategy
from client_utils import get_send_messages_helper, run_on_queue
from android_utils import run_on_ui_thread

__id__ = "url_cleaner"
__name__ = "URL Cleaner"
__description__ = "Automatically cleans Instagram & YouTube URLs by removing tracking parameters.\nhttps://github.com/lildavegoth/lildavegoth"
__author__ = "@ravana69 & @lildavegoth"
__min_version__ = "11.9.0"
__icon__ = "kirakustickers/0"

class InstaYTURLCleaner(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()

    def on_plugin_unload(self):
        self.remove_on_send_message_hook()

    def clean_urls(self, text):
        insta_pattern = r"(https://www\.instagram\.com/(?:p|reel|tv|stories)/[\w\-]+)(?:/\S*|\?\S*)?"
        text = re.sub(insta_pattern, r"\1/", text)

        yt_pattern = r"(https?://(?:www\.)?youtube\.com/(?:watch\?v=[\w\-]+|shorts/[\w\-]+|live/[\w\-]+|embed/[\w\-]+)|https?://youtu\.be/[\w\-]+)(?:\?\S*)?"
        text = re.sub(yt_pattern, r"\1", text)

        return text

    def on_send_message_hook(self, account, params):
        if not hasattr(params, "message") or not isinstance(params.message, str):
            return HookResult()

        original = params.message
        cleaned = self.clean_urls(original)

        if original == cleaned:
            return HookResult()

        def task():
            def send():
                params.message = cleaned
                get_send_messages_helper().sendMessage(params)

            run_on_ui_thread(send)

        run_on_queue(task)
        return HookResult(strategy=HookStrategy.CANCEL)