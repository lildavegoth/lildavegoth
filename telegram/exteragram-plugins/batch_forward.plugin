import re
import threading

from base_plugin import BasePlugin, HookResult, HookStrategy
from android_utils import run_on_ui_thread
from hook_utils import find_class
from java import dynamic_proxy, jint, jlong
from java.util import Random
from ui.bulletin import BulletinHelper

__name__ = "Batch Forward"
__description__ = "Forwards any messages without limits, without sender name and supports for Bulk or Batch forwards! (.forward url).\nhttps://github.com/lildavegoth/lildavegoth"
__version__ = "1.1.1"
__id__ = "batch_forward"
__author__ = "@lildavegoth"
__icon__ = "kirakustickers/3"


class RestrictForward(BasePlugin):

    def on_plugin_load(self):
        self.add_on_send_message_hook()

    def _show_info(self, text):
        run_on_ui_thread(lambda: BulletinHelper.show_info(text))

    def _show_error(self, text):
        run_on_ui_thread(lambda: BulletinHelper.show_error(text))

    def _show_success(self, text):
        run_on_ui_thread(lambda: BulletinHelper.show_success(text))

    def _create_int_arraylist(self):
        ArrayList = find_class("java.util.ArrayList")
        return ArrayList()

    def _create_long_arraylist(self):
        ArrayList = find_class("java.util.ArrayList")
        return ArrayList()

    def _process_updates(self, response, account):
        try:
            TLRPC = find_class("org.telegram.tgnet.TLRPC")
            if isinstance(response, TLRPC.Updates):
                run_on_ui_thread(lambda: find_class("org.telegram.messenger.MessagesController")
                                 .getInstance(account)
                                 .processUpdates(response, True))
        except Exception as e:
            self._show_error(f"UI update error: {str(e)}")

    def on_send_message_hook(self, account: int, params):
        msg = params.message
        if not msg:
            return HookResult()

        if not (msg.startswith(".forward") or msg.startswith("/forward")):
            return HookResult()

        parts = msg.split(" ", 1)
        if len(parts) < 2:
            self._show_info("Usage: .forward <telegram link>")
            return HookResult(strategy=HookStrategy.CANCEL)

        rest = parts[1].strip()
        links = re.findall(r'https?://t\.me/(?:c/)?[^/\s]+/\d+(?:/\d+)?', rest)
        if not links:
            self._show_error("No valid Telegram message link found.")
            return HookResult(strategy=HookStrategy.CANCEL)

        threading.Thread(target=self._forward_all, args=(account, links, params), daemon=True).start()
        return HookResult(strategy=HookStrategy.CANCEL)

    def _forward_all(self, account, links, params):
        for url in links:
            done = threading.Event()
            self._forward_message(account, url, params, url, done)
            done.wait()  # wait until this URL's send is fully complete

    def _forward_message(self, account, url, params, source_url, done_event=None):
        try:
            pattern = r"https?://t\.me/(c/)?([^/]+)/(\d+)(?:/(\d+))?"
            match = re.search(pattern, url)
            if not match:
                self._show_error(f"Invalid link: {url}")
                if done_event: done_event.set()
                return

            is_private = match.group(1) is not None
            peer_identifier = match.group(2)

            if match.group(4):
                message_id = int(match.group(4))
            else:
                message_id = int(match.group(3))

            MessagesController = find_class("org.telegram.messenger.MessagesController")
            TLRPC = find_class("org.telegram.tgnet.TLRPC")
            ConnectionsManager = find_class("org.telegram.tgnet.ConnectionsManager")

            if not MessagesController or not TLRPC or not ConnectionsManager:
                self._show_error("Failed to load required core classes.")
                if done_event: done_event.set()
                return

            connections = ConnectionsManager.getInstance(account)
            controller = MessagesController.getInstance(account)
            RequestDelegate = find_class("org.telegram.tgnet.RequestDelegate")

            def proceed_with_peer(resolved_peer, chat_object=None):
                if not resolved_peer:
                    self._show_error("Could not trace link source location.")
                    if done_event: done_event.set()
                    return

                msg_req = TLRPC.TL_messages_getHistory()
                msg_req.peer = resolved_peer
                msg_req.offset_id = jint(message_id + 5)
                msg_req.offset_date = jint(0)
                msg_req.add_offset = jint(0)
                msg_req.limit = jint(15)
                msg_req.max_id = jint(0)
                msg_req.min_id = jint(0)
                msg_req.hash = jlong(0)

                class GetHistoryDelegate(dynamic_proxy(RequestDelegate)):
                    def __init__(self, plugin, current_account, source_peer, target_params, src_chat, src_url, done_evt):
                        super().__init__()
                        self.plugin = plugin
                        self.account = current_account
                        self.source_peer = source_peer
                        self.target_params = target_params
                        self.src_chat = src_chat
                        self.source_url = src_url
                        self.done_event = done_evt

                    def run(self, response, error):
                        if error is not None:
                            self.plugin._show_error(f"Failed to fetch history: {error.text}")
                            if self.done_event: self.done_event.set()
                            return

                        messages = response.messages
                        if messages is None or messages.size() == 0:
                            self.plugin._show_error("Channel history inaccessible.")
                            if self.done_event: self.done_event.set()
                            return

                        target_msg = None
                        for i in range(messages.size()):
                            m = messages.get(i)
                            if m.id == message_id:
                                target_msg = m
                                break

                        if target_msg is None:
                            self.plugin._show_error("Target message ID not found.")
                            if self.done_event: self.done_event.set()
                            return

                        messages_to_process = self.plugin._create_int_arraylist()
                        message_objects_list = []

                        grouped_id = getattr(target_msg, 'grouped_id', jlong(0))

                        if grouped_id != 0:
                            for i in range(messages.size() - 1, -1, -1):
                                m = messages.get(i)
                                if getattr(m, 'grouped_id', jlong(0)) == grouped_id:
                                    messages_to_process.add(jint(m.id))
                                    message_objects_list.append(m)
                        else:
                            messages_to_process.add(jint(target_msg.id))
                            message_objects_list.append(target_msg)

                        try:
                            destination_peer = self.plugin._get_current_peer_compiled(self.account, self.target_params)
                            if destination_peer is None:
                                self.plugin._show_error("Destination chat context missing.")
                                if self.done_event: self.done_event.set()
                                return

                            self._send_cloned_via_helper(message_objects_list, destination_peer, self.source_url)

                        except Exception as e:
                            self.plugin._show_error(f"Execution handling failure: {str(e)}")
                            if self.done_event: self.done_event.set()

                    def _send_cloned_via_helper(self, msg_list, dest_peer, source_url):
                        TLRPC = find_class("org.telegram.tgnet.TLRPC")
                        ConnectionsManager = find_class("org.telegram.tgnet.ConnectionsManager")
                        if not TLRPC or not ConnectionsManager:
                            self.plugin._show_error("Core classes missing for cloning.")
                            if self.done_event: self.done_event.set()
                            return

                        # Find main text for album caption
                        main_text = ""
                        for m in msg_list:
                            txt = getattr(m, 'message', "") or ""
                            if txt:
                                main_text = txt
                                break
                        final_text = main_text
                        if final_text:
                            final_text += "\n\n" + source_url
                        else:
                            final_text = source_url

                        # Separate media messages
                        media_messages = [m for m in msg_list if hasattr(m, 'media') and m.media and not isinstance(m.media, TLRPC.TL_messageMediaEmpty)]

                        if len(media_messages) > 1:
                            # Send as album
                            multi_req = TLRPC.TL_messages_sendMultiMedia()
                            multi_req.peer = dest_peer

                            single_media_list = self.plugin._create_int_arraylist()
                            for idx, m in enumerate(media_messages):
                                media_obj = m.media
                                single_media = TLRPC.TL_inputSingleMedia()
                                single_media.random_id = jlong(Random().nextLong() & 0x7FFFFFFFFFFFFFFF)

                                if "TL_messageMediaDocument" in media_obj.getClass().getName() and getattr(media_obj, 'document', None):
                                    input_media = TLRPC.TL_inputMediaDocument()
                                    input_media.id = TLRPC.TL_inputDocument()
                                    input_media.id.id = jlong(media_obj.document.id)
                                    input_media.id.access_hash = jlong(media_obj.document.access_hash)
                                    input_media.id.file_reference = media_obj.document.file_reference
                                    single_media.media = input_media
                                elif "TL_messageMediaPhoto" in media_obj.getClass().getName() and getattr(media_obj, 'photo', None):
                                    input_media = TLRPC.TL_inputMediaPhoto()
                                    input_media.id = TLRPC.TL_inputPhoto()
                                    input_media.id.id = jlong(media_obj.photo.id)
                                    input_media.id.access_hash = jlong(media_obj.photo.access_hash)
                                    input_media.id.file_reference = media_obj.photo.file_reference
                                    single_media.media = input_media
                                else:
                                    continue

                                single_media.message = final_text if idx == 0 else ""
                                single_media_list.add(single_media)

                            multi_req.multi_media = single_media_list

                            class MultiMediaDelegate(dynamic_proxy(RequestDelegate)):
                                def __init__(self, plugin, account, done_evt):
                                    super().__init__()
                                    self.plugin = plugin
                                    self.account = account
                                    self.done_event = done_evt
                                def run(self, resp, err):
                                    if err is not None:
                                        self.plugin._show_error(f"Album send failed: {err.text}")
                                    else:
                                        self.plugin._process_updates(resp, self.account)
                                    if self.done_event: self.done_event.set()

                            ConnectionsManager.getInstance(self.account).sendRequest(multi_req, MultiMediaDelegate(self.plugin, self.account, self.done_event))
                        elif len(media_messages) == 1:
                            # Single media
                            m = media_messages[0]
                            media_obj = m.media
                            send_req = None
                            if "TL_messageMediaDocument" in media_obj.getClass().getName() and getattr(media_obj, 'document', None):
                                input_media = TLRPC.TL_inputMediaDocument()
                                input_media.id = TLRPC.TL_inputDocument()
                                input_media.id.id = jlong(media_obj.document.id)
                                input_media.id.access_hash = jlong(media_obj.document.access_hash)
                                input_media.id.file_reference = media_obj.document.file_reference
                                send_req = TLRPC.TL_messages_sendMedia()
                                send_req.media = input_media
                            elif "TL_messageMediaPhoto" in media_obj.getClass().getName() and getattr(media_obj, 'photo', None):
                                input_media = TLRPC.TL_inputMediaPhoto()
                                input_media.id = TLRPC.TL_inputPhoto()
                                input_media.id.id = jlong(media_obj.photo.id)
                                input_media.id.access_hash = jlong(media_obj.photo.access_hash)
                                input_media.id.file_reference = media_obj.photo.file_reference
                                send_req = TLRPC.TL_messages_sendMedia()
                                send_req.media = input_media

                            if send_req:
                                send_req.peer = dest_peer
                                send_req.message = final_text
                                send_req.random_id = jlong(Random().nextLong() & 0x7FFFFFFFFFFFFFFF)

                                class ClonedMediaDelegate(dynamic_proxy(RequestDelegate)):
                                    def __init__(self, plugin, account, done_evt):
                                        super().__init__()
                                        self.plugin = plugin
                                        self.account = account
                                        self.done_event = done_evt
                                    def run(self, resp, err):
                                        if err is not None:
                                            self.plugin._show_error(f"Cloned media failed: {err.text}")
                                        else:
                                            self.plugin._process_updates(resp, self.account)
                                        if self.done_event: self.done_event.set()

                                ConnectionsManager.getInstance(self.account).sendRequest(send_req, ClonedMediaDelegate(self.plugin, self.account, self.done_event))
                            else:
                                self.plugin._show_error("Unsupported media type.")
                                if self.done_event: self.done_event.set()
                        else:
                            # Pure text
                            if final_text.strip():
                                msg_req = TLRPC.TL_messages_sendMessage()
                                msg_req.peer = dest_peer
                                msg_req.message = final_text
                                msg_req.random_id = jlong(Random().nextLong() & 0x7FFFFFFFFFFFFFFF)

                                class ClonedTextDelegate(dynamic_proxy(RequestDelegate)):
                                    def __init__(self, plugin, account, done_evt):
                                        super().__init__()
                                        self.plugin = plugin
                                        self.account = account
                                        self.done_event = done_evt
                                    def run(self, resp, err):
                                        if err is not None:
                                            self.plugin._show_error(f"Cloned text failed: {err.text}")
                                        else:
                                            self.plugin._process_updates(resp, self.account)
                                        if self.done_event: self.done_event.set()

                                ConnectionsManager.getInstance(self.account).sendRequest(msg_req, ClonedTextDelegate(self.plugin, self.account, self.done_event))
                            else:
                                if self.done_event: self.done_event.set()

                        self.plugin._show_success("Message forwarded with source!")

                connections.sendRequest(msg_req, GetHistoryDelegate(self, account, resolved_peer, params, chat_object, source_url, done_event))

            if is_private:
                try:
                    raw_id = int(peer_identifier)
                    chat = controller.getChat(jlong(raw_id))
                    if chat is not None:
                        proceed_with_peer(controller.getInputPeer(chat), chat)
                    else:
                        peer_channel = TLRPC.TL_inputPeerChannel()
                        peer_channel.channel_id = jlong(raw_id)
                        peer_channel.access_hash = jlong(0)
                        proceed_with_peer(peer_channel, None)
                except Exception as ex:
                    self._show_error(f"Private parsing failed: {str(ex)}")
                    if done_event: done_event.set()
            else:
                req = TLRPC.TL_contacts_resolveUsername()
                req.username = peer_identifier

                class UsernameResolveDelegate(dynamic_proxy(RequestDelegate)):
                    def __init__(self, plugin, callback):
                        super().__init__()
                        self.plugin = plugin
                        self.callback = callback

                    def run(self, response, error):
                        if error is not None:
                            self.plugin._show_error(f"Username resolution failure: {error.text}")
                            if done_event: done_event.set()
                            return
                        if response.chats is not None and response.chats.size() > 0:
                            target_chat = response.chats.get(0)
                            self.callback(controller.getInputPeer(target_chat), target_chat)
                        elif response.users is not None and response.users.size() > 0:
                            self.callback(controller.getInputPeer(response.users.get(0)), None)
                        else:
                            self.plugin._show_error("Target reference entity not found.")
                            if done_event: done_event.set()

                connections.sendRequest(req, UsernameResolveDelegate(self, proceed_with_peer))

        except Exception as e:
            self._show_error(f"Critical exception: {str(e)}")
            if done_event: done_event.set()

    def _get_dialog_id_from_peer(self, peer):
        if hasattr(peer, 'chat_id') and peer.chat_id != 0:
            return jlong(-peer.chat_id)
        if hasattr(peer, 'channel_id') and peer.channel_id != 0:
            return jlong(-peer.channel_id)
        if hasattr(peer, 'user_id') and peer.user_id != 0:
            return jlong(peer.user_id)
        return jlong(0)

    def _get_current_peer_compiled(self, account, params):
        MessagesController = find_class("org.telegram.messenger.MessagesController")
        TLRPC = find_class("org.telegram.tgnet.TLRPC")
        if not MessagesController or not TLRPC:
            return None

        controller = MessagesController.getInstance(account)
        try:
            java_obj = params
            fields = java_obj.getClass().getDeclaredFields()
            for f in fields:
                f.setAccessible(True)
                val = f.get(java_obj)
                if val is not None:
                    if isinstance(val, TLRPC.InputPeer) or "InputPeer" in val.getClass().getName():
                        return val
                    if "Peer" in val.getClass().getName():
                        return controller.getInputPeer(val)
        except Exception:
            pass

        try:
            if hasattr(params, 'peer') and params.peer is not None:
                return params.peer if not isinstance(params.peer, (int, float)) else controller.getInputPeer(jlong(params.peer))
            if hasattr(params, 'to_id') and params.to_id is not None:
                return controller.getInputPeer(params.to_id)
        except Exception:
            pass

        try:
            LaunchActivity = find_class("org.telegram.ui.LaunchActivity")
            if LaunchActivity is not None and LaunchActivity.instance is not None:
                navigation_layout = LaunchActivity.instance.getActionBarLayout()
                if navigation_layout is not None:
                    fragments = navigation_layout.getFragmentStack()
                    if fragments is not None and fragments.size() > 0:
                        for i in range(fragments.size() - 1, -1, -1):
                            frag = fragments.get(i)
                            if frag is not None and "ChatActivity" in frag.getClass().getName():
                                args = frag.getArguments()
                                if args is not None:
                                    for key in ["chat_id", "user_id", "dialog_id", "peer_id"]:
                                        did = args.getLong(key, jlong(0))
                                        if did != 0:
                                            return self._peer_from_id(controller, did)
                                if hasattr(frag, 'getCurrentDialogId'):
                                    did = jlong(frag.getCurrentDialogId())
                                    if did != 0:
                                        return self._peer_from_id(controller, did)
        except Exception:
            pass
        return None

    def _peer_from_id(self, controller, dialog_id):
        try:
            if dialog_id < 0:
                chat = controller.getChat(jlong(-dialog_id))
                if chat is not None:
                    return controller.getInputPeer(chat)
            else:
                user = controller.getUser(jlong(dialog_id))
                if user is not None:
                    return controller.getInputPeer(user)
        except Exception:
            pass
        return None